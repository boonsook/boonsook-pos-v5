# Boonsook POS V5 — local test credentials
# Copy this file to .env then fill values
# .env is in .gitignore — never commit
#
# Used by:
#   npm run verify:security    → scripts/leave_spoof_test.js (Phase 92.45 leave RLS)
#   npm run verify:accounting  → scripts/accounting_integrity_smoke.js (Phase 92.46 auto-journal RLS)
#
# How to get values:
#   SUPABASE_URL / SUPABASE_ANON_KEY — ดูได้ใน supabase-config.js
#   NONADMIN / ADMIN — สร้าง 2 test accounts ใน Supabase Auth + ตั้ง role ใน profiles
#     (non-admin: role IN ('sales','technician','staff'), admin: role='admin')

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Non-admin test account (role != admin)
NONADMIN_EMAIL=
NONADMIN_PASSWORD=

# Admin test account (role = admin → is_accountant() = true)
ADMIN_EMAIL=
ADMIN_PASSWORD=
